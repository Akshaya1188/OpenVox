# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
venv/
.venv/
env/
ENV/

# Conda
.conda/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# OpenVox runtime data (personal, not for version control)
openvox/data/*.txt
!openvox/data/.gitkeep
openvox/logs/*.log
!openvox/logs/.gitkeep

# Environment variables / secrets
.env
